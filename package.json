{
  "name": "@local/dsh-readonly-mode",
  "version": "0.2.0",
  "private": true,
  "description": "Per-session read-only mode switch for the DSH chat composer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelloWorldNock/dsh-readonly-mode.git"
  },
  "homepage": "https://github.com/HelloWorldNock/dsh-readonly-mode#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "readonly",
    "guard"
  ],
  "type": "module",
  "scripts": {
    "test": "node test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
